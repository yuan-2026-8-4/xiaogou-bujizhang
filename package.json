{
  "name": "xiaogou-bujizhang",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:github": "tsc -b && vite build --mode github --base /xiaogou-bujizhang/",
    "build:capacitor": "tsc -b && vite build --mode capacitor",
